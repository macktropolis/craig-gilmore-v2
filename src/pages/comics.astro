---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Lightbox from '../components/Lightbox.astro';
import { thumb } from '../data/images';
import { getProjects, PUBLISHERS, TAG_LABELS, projectUrl } from '../data/portfolio';
import '../styles/gallery.css';

const comics = (await getProjects((p) => p.data.types.includes('comics'))).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'en', { numeric: true })
);
const sections = PUBLISHERS.map((pub) => ({
  ...pub,
  anchor: pub.id === 'comics-other' ? 'other' : pub.id === 'marvel' ? 'marvel' : 'dc',
  items: comics.filter((c) => c.data.publisher === pub.id),
})).filter((s) => s.items.length);
---

<BaseLayout
  title="Comics — Craig Gilmore"
  description="Comic book pencils, inks and colors by Craig Gilmore for DC Comics, Marvel and others — Justice League, Swamp Thing, Aquaman, Morbius and more."
>
  <PageBanner label="Portfolio" title="Comics" image="/images/home/card-comics.webp" imagePosition="center 25%">
    <nav slot="note" class="comics-jump" aria-label="Jump to publisher">
      {sections.map((s) => <a href={`#${s.anchor}`}>{s.label}</a>)}
    </nav>
  </PageBanner>

  <section class="gallery-section">
    <div class="container">
      {sections.map((s) => (
        <div class="project-block" id={s.anchor}>
          <div class="project-header">
            <h2 class="project-title">{s.label}</h2>
            <span class="project-meta">{s.items.length} pieces</span>
          </div>
          <div class="img-grid img-grid--sequence">
            {s.items.map((c) => {
              const img = c.data.images[0] ?? { src: c.data.cover!, caption: '' };
              const role = c.data.credit ?? c.data.tags.map((t) => TAG_LABELS[t]).filter(Boolean).join(', ');
              return (
                <div class="img-item" data-src={img.src} data-caption={`${c.data.title}${role ? ` — ${role}` : ''}`}>
                  <img {...thumb(img.src)} alt={`${c.data.title} ${role}`.trim()} loading="lazy" decoding="async" />
                  <span class="img-item-caption">
                    {c.data.title}
                    {role && <><br />{role}</>}
                  </span>
                </div>
              );
            })}
          </div>
          <p class="comics-links">
            {s.items.map((c, i) => (
              <>{i > 0 && ' · '}<a href={projectUrl(c)}>{c.data.title}</a></>
            ))}
          </p>
        </div>
      ))}
    </div>
  </section>

  <div class="commission-band">
    <div class="container commission-inner">
      <h2 class="commission-heading">Available for <em>Commissions</em></h2>
      <a href="/about/#commissions" class="btn btn-primary">Email About a Commission</a>
    </div>
  </div>

  <Lightbox />
</BaseLayout>

<style is:global>
  .comics-jump { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .comics-jump a { font-family: var(--font-cond); color: var(--text); text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; }
  .comics-jump a:hover { color: var(--accent); }
  .project-block { scroll-margin-top: calc(var(--nav-h) + 1.5rem); }
  .comics-links {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.9;
    color: var(--text-dim);
  }
  .comics-links a { color: var(--text-muted); }
  .comics-links a:hover { color: var(--accent); }
</style>
