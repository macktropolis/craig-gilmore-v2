---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const rendered = await Promise.all(posts.map(async (post) => ({ post, Content: (await render(post)).Content })));

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="News — Craig Gilmore"
  description="The latest news from comic book creator and storyboard artist Craig Gilmore."
>
  <!-- PAGE BANNER -->
  <div class="page-banner">
    <div class="container">
      <div class="page-banner-inner">
        <div>
          <p class="page-banner-label">Craig Gilmore</p>
          <h1 class="page-banner-title">News</h1>
        </div>
      </div>
    </div>
  </div>

  <!-- NEWS -->
  <section class="news-section" aria-label="News">
    <div class="container">
      <div class="news-search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" id="news-search" placeholder="Search news…" aria-label="Search news posts" />
      </div>

      <div class="news-grid" id="news-grid" aria-live="polite">
        {rendered.map(({ post, Content }) => (
          <article
            class="news-card reveal"
            tabindex="0"
            role="button"
            aria-label={`Read more: ${post.data.title}`}
            data-id={post.id}
            data-title={post.data.title}
            data-date={formatDate(post.data.date)}
            data-image={post.data.image}
            data-search={[post.data.title, post.data.excerpt, ...post.data.tags].join(' ').toLowerCase()}
          >
            <div class="news-card-img">
              {post.data.image ? (
                <img src={post.data.image} alt="" loading="lazy" />
              ) : (
                <div class="news-card-img-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9l4-4 4 4 4-5 4 5"></path><circle cx="8.5" cy="13.5" r="1.5"></circle>
                  </svg>
                </div>
              )}
            </div>
            <div class="news-card-body">
              <div class="news-card-meta">
                <span class="news-card-date">{formatDate(post.data.date)}</span>
                <div class="news-card-tags">
                  {post.data.tags.map((t) => <span class="news-card-tag">{t}</span>)}
                </div>
              </div>
              <h2 class="news-card-headline">{post.data.title}</h2>
              <p class="news-card-excerpt">{post.data.excerpt}</p>
              <span class="news-card-read-more">Read more &rarr;</span>
            </div>
            <template class="news-card-content"><Content /></template>
          </article>
        ))}
      </div>
      <p class:list={['news-empty', { visible: posts.length === 0 }]} id="news-empty">
        {posts.length === 0 ? 'No news posts yet.' : 'No posts match your search.'}
      </p>
    </div>
  </section>

  <!-- MODAL -->
  <div class="modal-backdrop" id="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modal-headline">
    <div class="modal" id="modal">
      <div class="modal-header">
        <div class="modal-meta">
          <span class="modal-date" id="modal-date"></span>
          <div class="news-card-tags" id="modal-tags"></div>
        </div>
        <button class="modal-close" id="modal-close" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <img class="modal-img" id="modal-img" src="" alt="" style="display:none;" />
      <div class="modal-body">
        <h2 class="modal-headline" id="modal-headline"></h2>
        <div class="modal-content" id="modal-content"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
    h1, h2, h3, h4, h5, h6 { font-weight: 400; }

    /* Page banner */
    .page-banner {
      padding-top: var(--nav-h);
      padding-bottom: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .page-banner-inner {
      display: flex;
      align-items: flex-end;
      gap: 2rem;
      padding: clamp(3rem, 6vw, 5rem) 0 2rem;
    }
    .page-banner-label {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      font-family: var(--font-cond);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.75rem;
    }
    .page-banner-label::before {
      content: '';
      display: block;
      width: 22px; height: 2px;
      background: var(--accent);
    }
    .page-banner-title {
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 6rem);
      line-height: 0.95;
      letter-spacing: 0.025em;
      color: var(--text);
    }

    /* News section */
    .news-section {
      padding: clamp(3rem, 6vw, 5rem) 0;
    }

    /* Search */
    .news-search-wrap {
      margin-bottom: 2.5rem;
      position: relative;
      max-width: 480px;
    }
    .news-search-wrap svg {
      position: absolute;
      left: 0.875rem;
      top: 50%;
      transform: translateY(-50%);
      width: 16px; height: 16px;
      color: var(--text-dim);
      pointer-events: none;
    }
    #news-search {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.625rem 1rem 0.625rem 2.5rem;
      font-family: var(--font-body);
      font-size: 0.875rem;
      color: var(--text);
      outline: none;
      transition: border-color 0.15s;
    }
    #news-search::placeholder { color: var(--text-dim); }
    #news-search:focus { border-color: var(--accent); }

    /* Card grid */
    .news-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
    }
    .news-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 5px;
      overflow: hidden;
      cursor: pointer;
      transition: border-color 0.18s, transform 0.18s;
      display: flex;
      flex-direction: column;
    }
    .news-card:hover {
      border-color: var(--border-hi);
      transform: translateY(-2px);
    }
    .news-card-img {
      aspect-ratio: 16/9;
      overflow: hidden;
      background: var(--surface-hi);
    }
    .news-card-img img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 0.3s;
    }
    .news-card:hover .news-card-img img { transform: scale(1.03); }
    .news-card-img-placeholder {
      width: 100%; height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #181010 0%, #100808 100%);
    }
    .news-card-img-placeholder svg {
      width: 40px; height: 40px;
      color: var(--text-dim);
      opacity: 0.3;
    }
    .news-card-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .news-card-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }
    .news-card-date {
      font-family: var(--font-cond);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .news-card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
    }
    .news-card-tag {
      font-family: var(--font-cond);
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-dim);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 0.125rem 0.375rem;
    }
    .news-card-headline {
      font-family: var(--font-display);
      font-size: 1.25rem;
      line-height: 1.15;
      color: var(--text);
      margin-bottom: 0.625rem;
    }
    .news-card-excerpt {
      font-size: 0.875rem;
      line-height: 1.7;
      color: var(--text-muted);
      flex: 1;
    }
    .news-card-read-more {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      margin-top: 1rem;
      font-family: var(--font-cond);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      transition: gap 0.15s;
    }
    .news-card:hover .news-card-read-more { gap: 0.625rem; }

    /* Empty state */
    .news-empty {
      text-align: center;
      padding: 4rem 0;
      color: var(--text-dim);
      font-family: var(--font-cond);
      font-size: 0.875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: none;
    }
    .news-empty.visible { display: block; }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.82);
      backdrop-filter: blur(4px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.22s, visibility 0s 0.22s;
    }
    .modal-backdrop.open {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.22s;
    }
    .modal {
      background: var(--surface);
      border: 1px solid var(--border-hi);
      border-radius: 6px;
      width: 100%;
      max-width: 680px;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
      transform: translateY(12px);
      transition: transform 0.22s;
    }
    .modal-backdrop.open .modal { transform: translateY(0); }
    .modal-header {
      position: sticky;
      top: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      z-index: 1;
    }
    .modal-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .modal-date {
      font-family: var(--font-cond);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .modal-close {
      background: none;
      border: 1px solid var(--border);
      border-radius: 3px;
      color: var(--text-muted);
      cursor: pointer;
      width: 32px; height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: border-color 0.15s, color 0.15s;
    }
    .modal-close:hover { border-color: var(--border-hi); color: var(--text); }
    .modal-close svg { width: 14px; height: 14px; }
    .modal-img {
      width: 100%;
      aspect-ratio: 16/9;
      object-fit: cover;
    }
    .modal-body {
      padding: 1.75rem 1.5rem 2rem;
    }
    .modal-headline {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 3vw, 2rem);
      line-height: 1.1;
      color: var(--text);
      margin-bottom: 1.25rem;
    }
    .modal-content {
      color: var(--text-muted);
      font-size: 0.9375rem;
      line-height: 1.85;
    }
    .modal-content p + p { margin-top: 1.1rem; }
    .modal-content strong { color: var(--text); font-weight: 500; }
    .modal-content a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
    .modal-content img { max-width: 100%; border-radius: 3px; margin: 1rem 0; }

    @media (max-width: 640px) {
      .news-grid { grid-template-columns: 1fr; }
      .modal { max-height: calc(100vh - 2rem); }
    }
  .news-card.is-hidden { display: none; }
</style>

<script>
  const backdrop = document.getElementById('modal-backdrop')!;
  const closeBtn = document.getElementById('modal-close')!;
  const imgEl = document.getElementById('modal-img') as HTMLImageElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.news-card'));
  const empty = document.getElementById('news-empty')!;

  function openModal(card: HTMLElement) {
    const { title = '', date = '', image } = card.dataset;
    document.getElementById('modal-date')!.textContent = date;
    document.getElementById('modal-headline')!.textContent = title;
    document.getElementById('modal-tags')!.innerHTML = card.querySelector('.news-card-tags')!.innerHTML;
    const content = document.getElementById('modal-content')!;
    content.replaceChildren(card.querySelector<HTMLTemplateElement>('.news-card-content')!.content.cloneNode(true));

    if (image) {
      imgEl.src = image;
      imgEl.alt = title;
      imgEl.style.display = 'block';
    } else {
      imgEl.style.display = 'none';
    }

    backdrop.classList.add('open');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeModal() {
    backdrop.classList.remove('open');
    document.body.style.overflow = '';
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => openModal(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModal(card);
      }
    });
  });

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', (e) => {
    if (e.target === backdrop) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  document.getElementById('news-search')!.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    let shown = 0;
    cards.forEach((card) => {
      const match = !q || (card.dataset.search ?? '').includes(q);
      card.classList.toggle('is-hidden', !match);
      if (match) shown++;
    });
    if (cards.length) empty.classList.toggle('visible', shown === 0);
  });
</script>
