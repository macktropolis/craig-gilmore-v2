---
import BaseLayout from '../layouts/BaseLayout.astro';

// Hero slideshow. Images live in public/images/home/ (resized WebP copies of portfolio art).
// `position` is the CSS object-position used to frame each piece in the hero.
const slides = [
  { src: '/images/home/hero-thor.webp', width: 658, height: 973, title: 'Thor', href: '/portfolio/thor/', alt: 'Thor, comic illustration by Craig Gilmore', position: 'center 20%' },
  { src: '/images/home/hero-swamp.webp', width: 1600, height: 1000, title: 'Swamp Thing', href: '/portfolio/swamp-thing-warner-brothersdc-comics/', alt: 'Swamp Thing concept art: a lab on stilts in a flooded swamp', position: '62% center' },
  { src: '/images/home/hero-cops.webp', width: 1600, height: 2068, title: "Let's Be Cops", href: '/portfolio/lets-be-cops-20th-century-fox-director-luke-greenfieldprod-designer-bill-arnold-images-posting-after-project-release/', alt: "Let's Be Cops key art painting by Craig Gilmore", position: 'center 35%' },
  { src: '/images/home/hero-cell.webp', width: 1333, height: 1000, title: 'Cell', href: '/portfolio/cell-benaroya-pictures-director-tod-kip-williams/', alt: 'Cell concept art: a cell tower crackling with lightning', position: '60% center' },
  { src: '/images/home/hero-rings.webp', width: 1600, height: 1600, title: 'Rings', href: '/portfolio/rings-paramount-pictures-director-f-javier-gutierrez/', alt: 'Rings concept art: sheets on a line before a dark mountain', position: 'center 45%' },
];
---

<BaseLayout
  title="Craig Gilmore — Comic Book Creator & Storyboard Artist"
  description="Official website of Craig Gilmore, veteran comic book creator, storyboard artist, and illustrator. 38 years of work in film, television, video games, and publishing."
>
  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="hero" aria-label="Introduction">

    <div class="hero-content">
      <p class="hero-eyebrow">Illustrator &amp; Artist</p>

      <h1 class="hero-name">
        <span class="hero-name-text"><span class="name-first">Craig</span> <span class="name-last">Gilmore</span></span>
      </h1>

      <p class="hero-roles">
        Comic Book Creator
        <span class="dot" aria-hidden="true">·</span>
        Storyboard Artist
        <span class="dot" aria-hidden="true">·</span>
        Illustrator
      </p>

      <p class="hero-bio">
        38-year veteran of comic books, motion picture, television, and video game illustration. Based in Bolivia, NC — working worldwide.
      </p>

      <div class="hero-ctas">
        <a href="#portfolio" class="btn btn-primary">View Portfolio</a>
        <a href="/ethereal/" class="btn btn-outline">Ethereal: A Tale</a>
      </div>
    </div>

    <div class="hero-visual" data-hero-slides aria-roledescription="carousel" aria-label="Featured artwork">
      {slides.map((slide, i) => (
        <img
          class:list={['hero-slide', { 'is-active': i === 0 }]}
          src={slide.src}
          width={slide.width}
          height={slide.height}
          alt={slide.alt}
          style={`object-position:${slide.position}`}
          fetchpriority={i === 0 ? 'high' : 'low'}
          decoding={i === 0 ? 'sync' : 'async'}
          aria-hidden={i === 0 ? undefined : 'true'}
          data-title={slide.title}
          data-href={slide.href}
        />
      ))}

      <div class="hero-controls">
        <a href={slides[0].href} class="hero-credit" data-hero-credit>Featured: <span>{slides[0].title}</span></a>
        <div class="hero-dots" role="group" aria-label="Choose featured artwork">
          {slides.map((slide, i) => (
            <button type="button" class:list={['hero-dot', { 'is-active': i === 0 }]} aria-label={`Show ${slide.title}`} aria-pressed={i === 0 ? 'true' : 'false'} data-index={i}></button>
          ))}
        </div>
        <button type="button" class="hero-pause" data-hero-pause aria-label="Pause slideshow" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-pause"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-play"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5z"/></svg>
        </button>
      </div>
    </div>

    <p class="scroll-hint" aria-hidden="true">Scroll</p>

  </section>

  <!-- ============================================================
       PORTFOLIO SECTION
       ============================================================ -->
  <section class="portfolio-section" id="portfolio" aria-label="Portfolio">
    <div class="container">

      <div class="portfolio-header">
        <div class="reveal">
          <p class="section-label">Selected Work</p>
          <h2 class="section-title">Portfolio</h2>
        </div>
        <a href="/portfolio/" class="btn btn-outline reveal reveal-delay-1"
           style="align-self:flex-end;">View All Work</a>
      </div>

      <div class="portfolio-grid">

        <!-- STORYBOARDS — large left card -->
        <a href="/storyboards/" class="p-card p-card--storyboards reveal">
          <img class="p-card-bg" src="/images/home/card-storyboards.webp" width="1100" height="1424" alt="" loading="lazy" decoding="async" />
          <div class="p-card-overlay">
            <p class="p-card-cat">Feature Work</p>
            <h3 class="p-card-name">Storyboards</h3>
            <span class="p-card-arrow">
              View Work
              <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </a>

        <!-- CONCEPT ART -->
        <a href="/concept-art/" class="p-card p-card--concept reveal reveal-delay-1">
          <img class="p-card-bg" src="/images/home/card-concept.webp" width="940" height="1194" alt="" loading="lazy" decoding="async" />
          <div class="p-card-overlay">
            <p class="p-card-cat">Development</p>
            <h3 class="p-card-name">Concept Art</h3>
            <span class="p-card-arrow">
              View Work
              <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </a>

        <!-- COMICS -->
        <a href="/comics/" class="p-card p-card--comics reveal reveal-delay-2">
          <img class="p-card-bg" src="/images/home/card-comics.webp" width="470" height="720" alt="" loading="lazy" decoding="async" />
          <div class="p-card-overlay">
            <p class="p-card-cat">Publishing</p>
            <h3 class="p-card-name">Comics</h3>
            <span class="p-card-arrow">
              View Work
              <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </a>

      </div>

    </div>
  </section>

  <!-- ============================================================
       ETHEREAL: A TALE
       ============================================================ -->
  <section class="ethereal-section" aria-label="Ethereal: A Tale — graphic novel">
    <div class="container">
      <div class="ethereal-inner">

        <div class="ethereal-visual reveal">
          <a href="/ethereal/" class="ethereal-cover">
            <img
              src="/images/home/ethereal-cover.webp"
              width="792" height="1224"
              alt="Ethereal: A Tale, Season One: Stygian promotional art"
              loading="lazy" decoding="async"
            />
          </a>
        </div>

        <div class="ethereal-content">
          <div class="ethereal-badge">
            <span class="pulse-dot" aria-hidden="true"></span>
            Now in Development
          </div>

          <p class="section-label reveal">Graphic Novel</p>
          <h2 class="ethereal-title reveal reveal-delay-1">Ethereal:<br>A Tale</h2>
          <p class="ethereal-subtitle reveal reveal-delay-2">An Original Graphic Novel by Craig Gilmore</p>

          <p class="ethereal-desc reveal reveal-delay-3">
            Craig's most ambitious creative work to date. Sign up to be notified about the official release announcement, preview art drops, and Kickstarter launch.
          </p>

          <div class="reveal reveal-delay-4">
            <a href="/ethereal/#signup" class="btn btn-primary">Get Notified of Release</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       ABOUT SNIPPET
       ============================================================ -->
  <section class="about-section" aria-label="About Craig Gilmore">
    <div class="container">
      <div class="about-inner">

        <div class="about-photo-wrap reveal">
          <div class="about-photo">
            <img
              src="/images/home/craig-portrait.webp"
              width="800" height="800"
              alt="Craig Gilmore"
              loading="lazy" decoding="async"
            />
          </div>
        </div>

        <div class="about-content">
          <p class="section-label reveal">About</p>
          <h2 class="section-title reveal reveal-delay-1">38 Years<br>in the Industry</h2>

          <div class="about-body reveal reveal-delay-2">
            <p>
              I am a 38-year veteran comic book creator and storyboard artist actively producing work for the motion picture, television, and video game industries, as well as advertising agencies and major comic book publishers.
            </p>
            <p>
              Based in Bolivia, NC, I work from my home studio with a fully mobile kit for on-location and remote productions. I am a proud <strong>I.A.T.S.E.</strong> union artist, represented for personal appearances by <strong>Pearl Talent Management</strong>.
            </p>
          </div>

          <div class="about-tags reveal reveal-delay-3">
            <span class="tag">I.A.T.S.E. Union</span>
            <span class="tag">Pearl Talent Management</span>
            <span class="tag">Concept Illustration</span>
            <span class="tag">Shooting Boards</span>
            <span class="tag">Comic Books</span>
            <span class="tag">Live Action</span>
          </div>

          <div class="about-ctas reveal reveal-delay-4">
            <a href="/about/"    class="btn btn-outline">Full Bio &amp; Résumé</a>
            <a href="/about/#commissions" class="btn btn-primary">Commission Info</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       COMMISSION BAND
       ============================================================ -->
  <div class="commission-band">
    <div class="container commission-inner">
      <h2 class="commission-heading reveal">
        Available for <em>Commissions</em>
      </h2>
      <a href="/about/#commissions" class="btn btn-primary reveal reveal-delay-1">
        Email About a Commission
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  // Hero slideshow: crossfades between the featured pieces every few seconds.
  // Pauses when the tab is hidden, when the visitor presses pause, and never
  // autoplays for visitors who prefer reduced motion.
  const root = document.querySelector<HTMLElement>('[data-hero-slides]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLImageElement>('.hero-slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.hero-dot')];
    const credit = root.querySelector<HTMLAnchorElement>('[data-hero-credit]')!;
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-hero-pause]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const INTERVAL = 6500;
    let current = 0;
    let timer: number | undefined;
    let paused = reduceMotion.matches;

    const show = (next: number) => {
      if (next === current) return;
      slides[current].classList.remove('is-active');
      slides[current].setAttribute('aria-hidden', 'true');
      dots[current].classList.remove('is-active');
      dots[current].setAttribute('aria-pressed', 'false');
      current = (next + slides.length) % slides.length;
      const slide = slides[current];
      slide.classList.add('is-active');
      slide.removeAttribute('aria-hidden');
      dots[current].classList.add('is-active');
      dots[current].setAttribute('aria-pressed', 'true');
      credit.href = slide.dataset.href!;
      credit.querySelector('span')!.textContent = slide.dataset.title!;
    };

    const stop = () => { window.clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (paused || document.hidden || slides.length < 2) return;
      timer = window.setInterval(() => show(current + 1), INTERVAL);
    };
    const setPaused = (value: boolean) => {
      paused = value;
      root.classList.toggle('is-paused', paused);
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
      start();
    };

    dots.forEach((dot) => dot.addEventListener('click', () => {
      show(Number(dot.dataset.index));
      start(); // restart the timer so the chosen piece gets a full turn
    }));
    pauseBtn.addEventListener('click', () => setPaused(!paused));
    document.addEventListener('visibilitychange', start);
    setPaused(paused);
  }
</script>
