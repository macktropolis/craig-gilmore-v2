<style is:global>
    .credits-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; align-self: flex-end; }
    h1, h2, h3, h4, h5, h6 { font-weight: 400; }

    /* Page banner */
    .page-banner {
      padding-top: var(--nav-h);
      padding-bottom: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .page-banner-inner {
      display: flex;
      align-items: flex-end;
      gap: 2rem;
      padding: clamp(3rem, 6vw, 5rem) 0 2rem;
    }
    .page-banner-label {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      font-family: var(--font-cond);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.75rem;
    }
    .page-banner-label::before {
      content: '';
      display: block;
      width: 22px; height: 2px;
      background: var(--accent);
    }
    .page-banner-title {
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 6rem);
      line-height: 0.95;
      letter-spacing: 0.025em;
      color: var(--text);
    }

    /* Bio section */
    .bio-section {
      padding: clamp(4rem, 8vw, 6rem) 0;
    }
    .bio-inner {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }
    .bio-photo-wrap { position: relative; }
    .bio-photo {
      width: 100%;
      aspect-ratio: 3/4;
      border-radius: 4px;
      overflow: hidden;
      background: var(--surface-hi);
      position: relative;
    }
    .bio-photo img {
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: top center;
      filter: grayscale(15%) contrast(1.05);
    }
    .bio-photo-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(160deg, #181210 0%, #0f0f0f 100%);
      font-family: var(--font-display);
      font-size: 5rem;
      color: var(--text-dim);
    }
    .bio-photo::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 55%, rgba(200,0,62,0.08));
      pointer-events: none;
    }
    .bio-photo-wrap::before {
      content: '';
      position: absolute;
      top: 1.5rem; bottom: 1.5rem;
      left: -1rem;
      width: 3px;
      background: var(--accent);
      border-radius: 2px;
    }

    .bio-content { padding-top: 0.25rem; }
    .bio-body {
      color: var(--text-muted);
      font-size: 0.9375rem;
      line-height: 1.85;
    }
    .bio-body p + p { margin-top: 1.25rem; }
    .bio-body strong { color: var(--text); font-weight: 500; }
    .bio-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }

    .bio-meta {
      margin-top: 2.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .bio-ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.5rem; }

    /* Commission section */
    .commission-section {
      background: var(--surface);
      padding: clamp(4rem, 8vw, 6rem) 0;
      position: relative;
      overflow: hidden;
    }
    .commission-section::before {
      content: '';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 600px; height: 400px;
      background: radial-gradient(ellipse, var(--accent-dim) 0%, transparent 70%);
      pointer-events: none;
    }
    .commission-inner { position: relative; z-index: 1; }
    .commission-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 4vw, 4rem);
      margin-top: 2.5rem;
    }
    .commission-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 2rem;
    }
    .commission-card-title {
      font-family: var(--font-cond);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.875rem;
    }
    .commission-card p {
      color: var(--text-muted);
      font-size: 0.9375rem;
      line-height: 1.75;
    }
    .commission-card strong { color: var(--text); font-weight: 500; }
    .commission-cta { margin-top: 2.5rem; }

    /* Credits section */
    .credits-section {
      padding: clamp(4rem, 8vw, 6rem) 0;
    }
    .credits-intro {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 3rem;
    }
    .credits-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border: 1px solid var(--border);
      border-radius: 4px;
      overflow: hidden;
    }
    .credit-item {
      display: grid;
      grid-template-columns: 4.5rem 1fr auto;
      align-items: baseline;
      gap: 1rem;
      padding: 0.875rem 1.25rem;
      border-bottom: 1px solid var(--border);
      transition: background 0.15s;
    }
    .credit-item:hover { background: var(--surface-hi); }
    .credit-item:last-child { border-bottom: none; }
    .credit-year {
      font-family: var(--font-cond);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--accent);
      white-space: nowrap;
    }
    .credit-title {
      font-size: 0.875rem;
      color: var(--text);
      line-height: 1.4;
    }
    .credit-role {
      font-family: var(--font-cond);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      white-space: nowrap;
    }

    /* Education */
    .education-section {
      background: var(--surface);
      padding: clamp(3rem, 6vw, 4rem) 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .education-inner {
      display: flex;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
      flex-wrap: wrap;
    }
    .education-degree {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 3vw, 2.5rem);
      color: var(--text);
      line-height: 1;
    }
    .education-meta {
      font-family: var(--font-cond);
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-top: 0.5rem;
    }

    /* Responsive */
    @media (max-width: 900px) {
      .bio-inner { grid-template-columns: 240px 1fr; }
      .commission-grid { grid-template-columns: 1fr; }
      .credits-list { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .bio-inner { grid-template-columns: 1fr; }
      .bio-photo-wrap::before { display: none; }
      .credits-intro { flex-direction: column; align-items: flex-start; }
      .credit-item { grid-template-columns: 3.5rem 1fr; }
      .credit-role { display: none; }
    }
  </style>
