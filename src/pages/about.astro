---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — Craig Gilmore"
  description="38-year veteran comic book creator and storyboard artist. Learn about Craig Gilmore's background, credits, and commission availability."
>
  <!-- PAGE BANNER -->
  <div class="page-banner">
    <div class="container">
      <div class="page-banner-inner">
        <div>
          <p class="page-banner-label">Craig Gilmore</p>
          <h1 class="page-banner-title">About</h1>
        </div>
      </div>
    </div>
  </div>

  <!-- BIO -->
  <section class="bio-section" aria-label="Biography">
    <div class="container">
      <div class="bio-inner">

        <div class="bio-photo-wrap reveal">
          <div class="bio-photo">
            <!-- Replace with: <img src="/images/craig-gilmore-portrait.jpg" alt="Craig Gilmore"> -->
            <div class="bio-photo-placeholder" aria-label="Portrait of Craig Gilmore">CG</div>
          </div>
        </div>

        <div class="bio-content">
          <p class="section-label reveal">Biography</p>
          <h2 class="section-title reveal reveal-delay-1">38 Years<br>in the Industry</h2>

          <div class="bio-body reveal reveal-delay-2">
            <p>
              Thank you for your interest in my work and welcome to my official website. I am a 38-year veteran comic book creator and storyboard artist actively producing work worldwide for the motion picture, television, and video game industries, as well as advertising agencies and major comic book publishers.
            </p>
            <p>
              I am currently based in Bolivia, NC and normally prefer to work from my home studio. However, I have a studio kit that is completely mobile for extended on-location as well as remote television and motion picture productions worldwide.
            </p>
            <p>
              With regards to the movie and television projects I take on, I am interested in <strong>conceptual illustration</strong>, <strong>poster illustration</strong>, and live action <strong>shooting boards</strong> — meaning quick and sketchy, with most of the work focusing on storytelling.
            </p>
            <p>
              I am a proud <strong>I.A.T.S.E.</strong> union artist. I am represented for personal appearances and guest speaking engagements by <strong>Pearl Talent Management</strong> — please contact Brittany Byrum at <a href="mailto:brittanyb.ptmgmt@gmail.com">brittanyb.ptmgmt@gmail.com</a>.
            </p>
            <p>
              You can also find my film and television credits on <a href="http://www.imdb.com/name/nm1725689/?ref_=fn_al_nm_2" target="_blank" rel="noopener">IMDb</a>.
            </p>
          </div>

          <div class="bio-meta reveal reveal-delay-3">
            <span class="tag">I.A.T.S.E. Union</span>
            <span class="tag">Pearl Talent Management</span>
            <span class="tag">Storyboard Artist</span>
            <span class="tag">Concept Illustration</span>
            <span class="tag">Poster Illustration</span>
            <span class="tag">Comic Books</span>
            <span class="tag">Live Action Shooting Boards</span>
            <span class="tag">Bolivia, NC</span>
          </div>

          <div class="bio-ctas reveal reveal-delay-4">
            <a href="mailto:craig@craiggilmore.net" class="btn btn-primary">Email Craig</a>
            <a href="http://www.imdb.com/name/nm1725689/" class="btn btn-outline" target="_blank" rel="noopener">View on IMDb ↗</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- COMMISSIONS -->
  <section class="commission-section" id="commissions" aria-label="Commission information">
    <div class="container commission-inner">

      <p class="section-label reveal">Work With Craig</p>
      <h2 class="section-title reveal reveal-delay-1">Commission Info</h2>

      <div class="commission-grid">
        <div class="commission-card reveal reveal-delay-1">
          <p class="commission-card-title">Availability</p>
          <p>Availability is based on Craig's current comics, film, or TV show workload. Turnaround time is generally <strong>1–2 months</strong>, and you will be kept updated on the status of your piece throughout.</p>
        </div>
        <div class="commission-card reveal reveal-delay-2">
          <p class="commission-card-title">Rates</p>
          <p>Craig uses a sliding scale that starts between <strong>$300 (black &amp; white)</strong> and <strong>$1,000 (full color)</strong>, based on your request factors. Commissions are normally completed on <strong>11×14 bristol board</strong> unless a specific size is requested.</p>
        </div>
        <div class="commission-card reveal reveal-delay-3">
          <p class="commission-card-title">Payment</p>
          <p>Payment is due when the piece is completed — <strong>PayPal or Square only</strong>. Pre-payment in person is accepted at shows. It's always okay to ask questions; Craig will do his best to work with you.</p>
        </div>
        <div class="commission-card reveal reveal-delay-4">
          <p class="commission-card-title">Convention Sketches</p>
          <p>Craig sells pre-drawn original sketches at his table at conventions, and may maintain a post-show sketch list for pieces completed at home. Live sketching at shows is limited — check with him at the table during slower periods.</p>
        </div>
      </div>

      <div class="commission-cta reveal">
        <a href="mailto:craig@craiggilmore.net" class="btn btn-primary">Email About a Commission</a>
      </div>

    </div>
  </section>

  <!-- EDUCATION -->
  <div class="education-section">
    <div class="container">
      <div class="education-inner">
        <div>
          <h2 class="education-degree">Education</h2>
        </div>
        <div>
          <p class="education-degree" style="font-size: clamp(1.25rem, 2vw, 1.75rem); color: var(--text-muted);">Alamance Community College</p>
          <p class="education-meta">Graham, N.C. &nbsp;·&nbsp; 1987–1989 &nbsp;·&nbsp; A.A.S. — Commercial Art &amp; Illustration</p>
        </div>
      </div>
    </div>
  </div>

