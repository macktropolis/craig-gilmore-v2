---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { getProjects, TYPE_LABELS } from '../../data/portfolio';
import '../../styles/gallery.css';

const projects = await getProjects((p) => !p.data.types.includes('comics') && !p.data.tags.includes('ethereal'));
const groups = (['storyboards', 'concept-art'] as const).map((type) => ({
  type,
  label: TYPE_LABELS[type],
  projects: projects.filter((p) => p.data.types.includes(type)),
}));
---

<BaseLayout
  title="Full Portfolio — Craig Gilmore"
  description="Every storyboard and concept art project by Craig Gilmore for feature film, television, video games and commercials."
>
  <PageBanner label="Portfolio" title="Full Portfolio" image="/images/home/hero-swamp.webp" imagePosition="60% center">
    <p slot="note">Every film, television, video game and commercial project. Comic book work is on the <a href="/comics/">Comics</a> page.</p>
  </PageBanner>

  <section class="gallery-section">
    <div class="container">
      {groups.map((g) => (
        <div class="project-block">
          <div class="project-header">
            <h2 class="project-title">{g.label}</h2>
            <span class="project-meta">{g.projects.length} projects</span>
          </div>
          <ProjectGrid projects={g.projects} filters />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

