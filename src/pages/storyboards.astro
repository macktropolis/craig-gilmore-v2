<style is:global>
    h1, h2, h3, h4, h5, h6 { font-weight: 400; }

    /* Page banner */
    .page-banner {
      padding-top: var(--nav-h);
      border-bottom: 1px solid var(--border);
    }
    .page-banner-inner {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      padding: clamp(3rem, 6vw, 5rem) 0 2rem;
      flex-wrap: wrap;
    }
    .page-banner-label {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      font-family: var(--font-cond);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.75rem;
    }
    .page-banner-label::before {
      content: '';
      display: block;
      width: 22px; height: 2px;
      background: var(--accent);
    }
    .page-banner-title {
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 6rem);
      line-height: 0.95;
      letter-spacing: 0.025em;
      color: var(--text);
    }
    .page-banner-note {
      font-family: var(--font-cond);
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      max-width: 36ch;
      line-height: 1.6;
      align-self: flex-end;
      padding-bottom: 0.25rem;
    }

    /* Gallery layout */
    .gallery-section {
      padding: clamp(4rem, 8vw, 6rem) 0;
    }

    /* Project block */
    .project-block {
      margin-bottom: clamp(4rem, 8vw, 6rem);
    }
    .project-block:last-child { margin-bottom: 0; }

    .project-header {
      display: flex;
      align-items: baseline;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
    }
    .project-title {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      color: var(--text);
      line-height: 1;
    }
    .project-meta {
      font-family: var(--font-cond);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .project-tag {
      font-family: var(--font-cond);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      border: 1px solid rgba(200,0,62,0.35);
      border-radius: 2px;
      padding: 0.2rem 0.6rem;
      margin-left: auto;
    }

    /* Image grid */
    .img-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.75rem;
    }
    .img-grid--wide {
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    }
    .img-grid--sequence {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }

    .img-item {
      position: relative;
      overflow: hidden;
      border-radius: 3px;
      background: var(--surface);
      cursor: zoom-in;
    }
    .img-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
      aspect-ratio: 4/3;
    }
    .img-grid--sequence .img-item img {
      aspect-ratio: 3/4;
    }
    .img-item:hover img { transform: scale(1.04); }

    .img-item-caption {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.85));
      padding: 1.5rem 0.875rem 0.75rem;
      font-family: var(--font-cond);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      opacity: 0;
      transition: opacity 0.25s;
    }
    .img-item:hover .img-item-caption { opacity: 1; }

    /* Lightbox */
    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(0,0,0,0.94);
      align-items: center;
      justify-content: center;
      cursor: zoom-out;
    }
    .lightbox.is-open { display: flex; }
    .lightbox img {
      max-width: 92vw;
      max-height: 90vh;
      object-fit: contain;
      border-radius: 2px;
      box-shadow: 0 0 80px rgba(0,0,0,0.6);
      cursor: default;
    }
    .lightbox-close {
      position: absolute;
      top: 1.25rem; right: 1.5rem;
      font-family: var(--font-cond);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-muted);
      background: none;
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 0.4rem 0.875rem;
      cursor: pointer;
      transition: all 0.15s;
    }
    .lightbox-close:hover { color: var(--text); border-color: var(--border-hi); }
    .lightbox-caption {
      position: absolute;
      bottom: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-cond);
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
      white-space: nowrap;
    }

    @media (max-width: 640px) {
      .img-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
      .img-grid--sequence { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
      .project-tag { margin-left: 0; }
    }
  </style>

<script>
  // Lightbox
  const lightbox = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbCaption = document.getElementById('lightbox-caption')!;
  const lbClose = document.getElementById('lightbox-close')!;

  document.querySelectorAll<HTMLElement>('.img-item').forEach((item) => {
    item.addEventListener('click', () => {
      lbImg.src = item.dataset.src ?? '';
      lbImg.alt = item.querySelector('img')?.alt ?? '';
      lbCaption.textContent = item.dataset.caption || '';
      lightbox.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    lbImg.src = '';
    document.body.style.overflow = '';
  }

  lbClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
