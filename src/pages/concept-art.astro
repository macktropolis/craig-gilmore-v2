---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getProjects } from '../data/portfolio';
import '../styles/gallery.css';

const projects = await getProjects((p) => p.data.types.includes('concept-art'));
---

<BaseLayout
  title="Concept Art — Craig Gilmore"
  description="Concept art by Craig Gilmore for feature film, television and video games — including Coming 2 America, Swamp Thing, Stranger Things and Prisoners."
>
  <div class="page-banner">
    <div class="container">
      <div class="page-banner-inner">
        <div>
          <p class="page-banner-label">Portfolio</p>
          <h1 class="page-banner-title">Concept Art</h1>
        </div>
        <p class="page-banner-note">Development art for film, television and video games. Choose a project to see the art.</p>
      </div>
    </div>
  </div>

  <section class="gallery-section">
    <div class="container">
      <ProjectGrid projects={projects} filters />
    </div>
  </section>

  <div class="commission-band">
    <div class="container commission-inner">
      <h2 class="commission-heading">Available for <em>Commissions</em></h2>
      <a href="/about/#commissions" class="btn btn-primary">Email About a Commission</a>
    </div>
  </div>
</BaseLayout>
