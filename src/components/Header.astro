---
import { primaryNav, social, STORE_URL } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Craig Gilmore — Home">
      <img src="/images/craig-logo-white-nobg.webp" alt="Craig Gilmore" />
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {primaryNav.map((item) =>
        item.children ? (
          <div class="nav-has-dropdown">
            <a href="#" class:list={['nav-link', { active: item.children.some((c) => isActive(c.href)) }]} aria-haspopup="true">
              {item.label} <span class="nav-caret">▾</span>
            </a>
            <div class="dropdown-menu" role="menu">
              {item.children.map((c) => <a href={c.href} role="menuitem">{c.label}</a>)}
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href!) }]}>{item.label}</a>
        )
      )}
      <a href={STORE_URL} class="nav-link nav-link-store" target="_blank" rel="noopener">
        Original Art Store <span class="ext-icon">↗</span>
      </a>
    </nav>

    <div class="header-social" aria-label="Social media links">
      {social.map((s) => (
        <a href={s.href} class="social-btn" aria-label={s.label} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
        </a>
      ))}
    </div>

    <button
      type="button"
      class="menu-toggle"
      id="menu-toggle"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span class="menu-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>

<!-- Mobile menu. Lives outside .site-header because the header's backdrop-filter
     would otherwise trap this fixed panel inside the 68px bar. -->
<div class="mobile-nav" id="mobile-nav" hidden>
  <nav class="mobile-nav-inner container" aria-label="Mobile navigation">
    <ul class="mobile-nav-list">
      {primaryNav.map((item) =>
        item.children ? (
          <li>
            <span class="mobile-nav-group">{item.label}</span>
            <ul class="mobile-nav-sub">
              {item.children.map((c) => (
                <li><a href={c.href} class:list={['mobile-nav-link', 'is-sub', { active: isActive(c.href) }]} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li>
            <a href={item.href} class:list={['mobile-nav-link', { active: isActive(item.href!) }]} aria-current={isActive(item.href!) ? 'page' : undefined}>{item.label}</a>
          </li>
        )
      )}
      <li>
        <a href={STORE_URL} class="mobile-nav-link" target="_blank" rel="noopener">Original Art Store <span class="ext-icon">↗</span></a>
      </li>
    </ul>

    <div class="mobile-nav-social">
      {social.map((s) => (
        <a href={s.href} class="social-btn" aria-label={s.label} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
        </a>
      ))}
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const panel = document.getElementById('mobile-nav') as HTMLElement;
  const desktop = window.matchMedia('(min-width: 901px)');

  function setOpen(open: boolean) {
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.classList.toggle('menu-open', open);
    if (open) panel.querySelector<HTMLElement>('a')?.focus();
  }

  toggle.addEventListener('click', () => setOpen(panel.hidden));
  panel.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
  // Close if the window grows past the breakpoint while the menu is open.
  desktop.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
